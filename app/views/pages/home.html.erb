<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ahmed Salah - Portfolio</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased">

  <!-- En-tête / Navigation -->
  <header class="fixed top-0 left-0 w-full z-50 bg-slate-950/80 backdrop-blur border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="#" class="text-xl font-bold tracking-tight text-indigo-400">Ahmed Salah</a>
      <nav class="hidden md:flex items-center space-x-8 text-sm font-medium">
        <a href="#about" class="hover:text-indigo-400 transition">À propos</a>
        <a href="#services" class="hover:text-indigo-400 transition">Services</a>
        <a href="#projects" class="hover:text-indigo-400 transition">Projets</a>
        <a href="#contact" class="hover:text-indigo-400 transition">Contact</a>
      </nav>
    </div>
  </header>

  <!-- Section Principale / Hero -->
  <section class="pt-32 pb-20 px-6 max-w-7xl mx-auto text-center md:text-left flex flex-col md:flex-row items-center justify-between">
    <div class="md:w-1/2 space-y-6">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight">
        Développeur & <span class="text-indigo-400">Créateur de Solutions</span>
      </h1>
      <p class="text-lg text-slate-400">
        Bienvenue sur mon portfolio. Je conçois des applications web modernes, performantes et sur mesure.
      </p>
      <div class="flex justify-center md:justify-start space-x-4">
        <a href="#contact" class="bg-indigo-600 text-white font-medium px-6 py-3 rounded-lg hover:bg-indigo-500 transition shadow-lg shadow-indigo-600/30">Me contacter</a>
        <a href="#projects" class="bg-slate-900 border border-slate-700 text-slate-200 font-medium px-6 py-3 rounded-lg hover:bg-slate-800 transition">Voir mes projets</a>
      </div>
    </div>
  </section>

  <!-- Section Services -->
  <section id="services" class="py-20 px-6 max-w-7xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-12">Mes Domaines d'Expertise</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-slate-900 border border-slate-800 p-8 rounded-xl">
        <h3 class="text-xl font-semibold text-indigo-400 mb-3">Développement Web</h3>
        <p class="text-slate-400">Applications sur mesure avec Ruby on Rails, JavaScript et des interfaces fluides.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 p-8 rounded-xl">
        <h3 class="text-xl font-semibold text-indigo-400 mb-3">Intégration & API</h3>
        <p class="text-slate-400">Connexion de services tiers, architectures robustes et sécurisées.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 p-8 rounded-xl">
        <h3 class="text-xl font-semibold text-indigo-400 mb-3">Optimisation VPS</h3>
        <p class="text-slate-400">Administration système, déploiement Linux, Puma et configurations de production.</p>
      </div>
    </div>
  </section>

  <!-- Section Projets -->
  <section id="projects" class="py-20 px-6 max-w-7xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-12">Projets Récents</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-slate-900 border border-slate-800 p-6 rounded-xl">
        <h3 class="text-xl font-bold text-white mb-2">Portfolio Principal</h3>
        <p class="text-slate-400 mb-4">Vitrine professionnelle avec administration intégrée et suivi des visites.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 p-6 rounded-xl">
        <h3 class="text-xl font-bold text-white mb-2">Kreatix Studio</h3>
        <p class="text-slate-400 mb-4">Plateforme de services créatifs et numériques.</p>
      </div>
    </div>
  </section>

  <!-- Section Contact (Bouton e-mail direct vers ahmed.slh1707@gmail.com) -->
  <section id="contact" class="py-20 px-6 max-w-3xl mx-auto text-center">
    <div class="bg-slate-900 border border-slate-800 p-10 rounded-2xl shadow-xl space-y-6">
      <h2 class="text-3xl font-bold text-white">Travaillons ensemble</h2>
      <p class="text-slate-400 text-lg">
        Une question, un projet ou une opportunité ? Écrivez-moi directement par e-mail, je vous répondrai rapidement.
      </p>
      <div>
        <a href="mailto:ahmed.slh1707@gmail.com?subject=Contact%20depuis%20le%20Portfolio" 
           class="inline-flex items-center justify-center bg-indigo-600 text-white font-semibold px-8 py-4 rounded-xl hover:bg-indigo-500 transition shadow-lg shadow-indigo-600/30 text-lg">
          <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          M'envoyer un e-mail
        </a>
      </div>
      <p class="text-xs text-slate-500">Cela ouvrira votre application de messagerie (ahmed.slh1707@gmail.com).</p>
    </div>
  </section>

  <!-- Pied de page -->
  <footer class="py-8 border-t border-slate-800 text-center text-sm text-slate-500">
    <p>&copy; 2026 Ahmed Salah. Tous droits réservés.</p>
  </footer>

</body>
</html>