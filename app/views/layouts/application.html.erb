<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Portfolio Ahmed Salah" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Portfolio Ahmed Salah">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <!-- Ajout du CDN Tailwind pour un design ultra-rapide et magnifique -->
    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-950 text-slate-100">
    <!-- On retire les classes restrictives pour laisser le portfolio s'afficher en plein écran -->
    <%= yield %>
  </body>
</html>